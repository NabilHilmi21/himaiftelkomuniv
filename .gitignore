# ==========================================
# HIMA IF CMS — Master .gitignore
# Stack: Next.js 15+ | FastAPI | PostgreSQL | Redis | Docker
# ==========================================

# ------------------------------------------
# 1. Local Testing & Scratch Work
# ------------------------------------------
/test
/scratch
/scripts
*.scratch.*

# ------------------------------------------
# 2. Environment Variables, Secrets & Keys
# ------------------------------------------
# Abaikan seluruh berkas konfigurasi rahasia
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# KECUALIKAN template .env.example agar tetap ter-track di git
!.env.example
!.env.production.example

# Kunci Kriptografi, Sertifikat SSL & Token
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
secrets/
certificates/
/docker/nginx/ssl/*.crt
/docker/nginx/ssl/*.key
!/docker/nginx/ssl/.gitkeep

# ------------------------------------------
# 3. Node.js & Frontend (Next.js)
# ------------------------------------------
# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js Build Output & Cache
.next/
out/
build/
dist/

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js bundle analyzer / profiling
.next-analytics/
next-env.d.ts.bak

# Vercel CLI & Telemetry
.vercel

# ------------------------------------------
# 4. Python & Backend (FastAPI / Celery)
# ------------------------------------------
# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Python Distribution / Packaging
.Python
develop-eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg

# Celery Beat & Tasks
celerybeat-schedule
celerybeat.pid
celerybeat-schedule.db
celerybeat-schedule.dir
celerybeat-schedule.bak

# Testing & Code Quality
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Linters & Static Analysis
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.ruff_cache/

# ------------------------------------------
# 5. Databases, In-Memory Stores & Storage
# ------------------------------------------
# SQLite & Local DB files
*.sqlite
*.sqlite3
*.db
*.db-journal

# Local Docker Volume Mounts & DB Data
postgres_data/
pgdata/
redis_data/
minio_data/
storage_data/
vault_data/

# Redis dumps
dump.rdb
appendonly.aof

# Local User Uploads & Media Assets (Penyimpanan lokal dev)
/uploads/
/media/raw/
/media/processed/
/media/attachments/
/storage/vault/*
/storage/public/*
!/storage/vault/.gitkeep
!/storage/public/.gitkeep

# ------------------------------------------
# 6. Log Files & Runtime Artifacts
# ------------------------------------------
*.log
logs/
*.pid
*.seed
*.sublime-project
*.sublime-workspace

# ------------------------------------------
# 7. OS & Editor Artifacts
# ------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~

# JetBrains (PyCharm, WebStorm, IntelliJ)
.idea/
*.iws
*.iml

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
*.vsix

# Vim
*.swp
*.swo
*.swn
*.swm